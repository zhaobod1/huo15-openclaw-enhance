{
  "name": "@huo15/huo15-openclaw-enhance",
  "version": "6.7.6",
  "publishConfig": {
    "access": "public"
  },
  "description": "\u706b\u4e00\u4e94\u00b7\u514b\u52b3\u5fb7\u00b7\u9f99\u867e\u589e\u5f3a\u63d2\u4ef6 v6.7.6 \u2014 \u4e0a\u4f20 URL \u7b80\u5316\u5230\u6700\u77ed /upload\uff1a\u7528\u6237\u5e0c\u671b\u300ehttps://keepermac.huo15.com/upload\u300f\u8fd9\u79cd\u77ed URL\u3002cc-media-bridge v2.18.9 \u5df2 native \u652f\u6301 /upload\uff08_lanhuo_strip \u8ba9 /upload \u76f4\u547d\u4e2d\u540c\u4efd UPLOAD_HTML\uff09\uff0cnginx \u4e0d\u7528\u5355\u72ec\u914d location\u3002enhance large-file-bridge.resolveUploadUrl \u9ed8\u8ba4\u63a8 /upload\uff1bcc-bridge-prompt + large-file-bridge prompt \u90fd\u6539 /upload \u77ed URL \u5f15\u5bfc LLM\u3002/lanhuo/upload \u548c /plugins/enhance/upload \u4ecd\u517c\u5bb9\u4f5c alias\u3002\u7ee7\u627f v6.7.5 2GB \u6d41\u5f0f\u4e0a\u4f20\u4e0d OOM + v6.7.4 dashboard \u4e0a\u4f20\u9875\u3002",
  "type": "module",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "openclawVersion": "2026.4.29"
    },
    "compat": {
      "pluginApi": ">=2026.4.24"
    }
  },
  "bin": {
    "openclaw-enhance-setup": "./scripts/setup.sh"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postinstall": "node scripts/postinstall.cjs",
    "build": "tsc && cp package.json dist/ && cp openclaw.plugin.json dist/ 2>/dev/null || true"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "enhance",
    "memory",
    "safety",
    "agent"
  ],
  "author": "jobzhao15",
  "license": "MIT",
  "peerDependencies": {
    "openclaw": "^2026.4.24"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "src/**/*",
    "templates/**/*",
    "scripts/**/*",
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/huo15/ai/huo15-openclaw-enhance"
  }
}
