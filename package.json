{
  "name": "@huo15/huo15-openclaw-enhance",
  "version": "6.7.11",
  "publishConfig": {
    "access": "public"
  },
  "description": "\u706b\u4e00\u4e94\u00b7\u514b\u52b3\u5fb7\u00b7\u9f99\u867e\u589e\u5f3a\u63d2\u4ef6 v6.7.11 \u2014 large-file-bridge \u53cc\u91cd prompt-following \u52a0\u56fa\uff08\u9488\u5bf9 MiniMax M2.7 \u7b49\u5f31\u6a21\u578b\u53cd\u5411\u64cd\u4f5c\uff09\uff1a\u7528\u6237\u5b9e\u6d4b wecom-default-dm-huangxuanrong agent \u7528 MiniMax M2.7\uff0cjsonl \u65e5\u5fd7\u786e\u8ba4 enhance prompt \u5df2\u6210\u529f\u6ce8\u5165\uff0c\u4f46 LLM **\u5b8c\u5168\u65e0\u89c6**\u786c\u6307\u4ee4\uff0c\u53cd\u800c exec grep wecom \u6e90\u7801\u81ea\u5df1\u63a2\u7d22\u300eMAX_DOCUMENT_BYTES\u300f\u5e76\u53cd\u95ee\u7528\u6237\u300e\u8bf7\u628a\u5b8c\u6574\u9519\u8bef\u6d88\u606f\u622a\u56fe\u53d1\u7ed9\u6211\u300f\u3002before_agent_reply \u515c\u5e95\u4e5f\u5931\u6548\u2014\u2014\u56e0\u4e3a LLM \u53d9\u8ff0\u6027\u56de\u590d\u91cc\u542b 'upload'/'\u4e0a\u4f20' \u5b50\u4e32\u5c31\u88ab body.includes \u8bef\u5224\u4e3a'\u5df2\u7ed9\u94fe\u63a5'\u3002\u4fee\u6cd5\uff1a(1) prompt \u6539\u547d\u4ee4\u5f0f\u786c\u89c4\u5219\u300e\u4f60\u7684\u56de\u590d\u5fc5\u987b\u662f\u4e0b\u9762\u8fd9\u4e00\u6bb5\uff0c\u4e00\u5b57\u4e0d\u6539\u300f+ \u660e\u786e\u7981\u6b62 exec/\u53cd\u95ee/\u6539\u914d\u7f6e\uff1b(2) \u515c\u5e95\u5173\u952e\u8bcd\u4ece body.includes('upload') \u6539\u4e3a\u6b63\u5219\u5339\u914d\u771f\u5b9e\u53ef\u70b9 URL\uff08/plugins/enhance(-upload)?/\uff09+ \u5de5\u5177\u540d marker\uff0c\u4e0d\u518d\u88ab\u53d9\u8ff0\u6027\u63d0\u5230\u8bef\u5224\u3002",
  "type": "module",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "openclawVersion": "2026.4.29"
    },
    "compat": {
      "pluginApi": ">=2026.4.24"
    }
  },
  "bin": {
    "openclaw-enhance-setup": "./scripts/setup.sh"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postinstall": "node scripts/postinstall.cjs",
    "build": "tsc && cp package.json dist/ && cp openclaw.plugin.json dist/ 2>/dev/null || true"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "enhance",
    "memory",
    "safety",
    "agent"
  ],
  "author": "jobzhao15",
  "license": "MIT",
  "peerDependencies": {
    "openclaw": "^2026.4.24"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "src/**/*",
    "templates/**/*",
    "scripts/**/*",
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/huo15/ai/huo15-openclaw-enhance"
  }
}
