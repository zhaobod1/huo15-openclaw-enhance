{
  "name": "@huo15/huo15-openclaw-enhance",
  "version": "6.7.5",
  "publishConfig": {
    "access": "public"
  },
  "description": "\u706b\u4e00\u4e94\u00b7\u514b\u52b3\u5fb7\u00b7\u9f99\u867e\u589e\u5f3a\u63d2\u4ef6 v6.7.5 \u2014 \u4e0a\u4f20\u652f\u6301\u5230 2GB \u5355\u6587\u4ef6\uff08\u6d41\u5f0f\u5199\u76d8\uff0c\u4e0d\u5168 buffer \u8fdb\u5185\u5b58\uff09\uff1a\u7528\u6237\u5b9e\u6d4b 100MB \u592a\u5c0f\uff0c\u5e0c\u671b\u652f\u6301\u5230 2GB\u3002(1) handleUpload \u52a0 octet-stream + X-Filename header \u8def\u5f84\uff0creq.pipe(createWriteStream) \u6d41\u5f0f\u76f4\u5199\u76d8\uff0c\u8fc7\u7a0b\u4e2d\u6309\u5b57\u8282\u7d2f\u8ba1 + \u8d85 2GB \u4e3b\u52a8 abort + \u5220\u5df2\u5199\u90e8\u5206\uff1b(2) \u8001 multipart/form-data \u8def\u5f84\u4fdd\u7559\u4f46\u52a0 100MB \u4e0a\u9650\uff08\u9632 Buffer.concat OOM\uff09\uff0c\u8d85\u8fc7\u63d0\u793a\u7528 octet-stream\uff1b(3) UPLOAD_HTML \u6539\u7528 xhr.send(file) \u4e8c\u8fdb\u5236\u6d41\u4e0a\u4f20\uff08\u6d4f\u89c8\u5668\u81ea\u52a8\u6d41\u5f0f\uff09\uff0cprogress \u5b9e\u65f6\u663e\u793a N MB / X GB \u767e\u5206\u6bd4\uff1b(4) \u540c\u6e90\u76f8\u5bf9\u8def\u5f84 location.pathname\uff0cnginx \u53cd\u4ee3 /lanhuo/upload \u6216 /plugins/enhance/upload \u90fd\u80fd\u547d\u4e2d\u540c\u4e00\u4efd\u540e\u7aef\uff1b(5) large-file-bridge prompt \u66f4\u65b0\u63d0\u5230\u300e2GB \u4ee5\u5185\u90fd\u53ef\u4ee5\u300f\u3002\u7ee7\u627f v6.7.4 /lanhuo/upload \u522b\u540d + URL \u9519\u4f4d\u4fee\u590d\u3002",
  "type": "module",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "openclawVersion": "2026.4.29"
    },
    "compat": {
      "pluginApi": ">=2026.4.24"
    }
  },
  "bin": {
    "openclaw-enhance-setup": "./scripts/setup.sh"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postinstall": "node scripts/postinstall.cjs",
    "build": "tsc && cp package.json dist/ && cp openclaw.plugin.json dist/ 2>/dev/null || true"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "enhance",
    "memory",
    "safety",
    "agent"
  ],
  "author": "jobzhao15",
  "license": "MIT",
  "peerDependencies": {
    "openclaw": "^2026.4.24"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "src/**/*",
    "templates/**/*",
    "scripts/**/*",
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/huo15/ai/huo15-openclaw-enhance"
  }
}
