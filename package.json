{
  "name": "@huo15/huo15-openclaw-enhance",
  "version": "6.7.10",
  "publishConfig": {
    "access": "public"
  },
  "description": "\u706b\u4e00\u4e94\u00b7\u514b\u52b3\u5fb7\u00b7\u9f99\u867e\u589e\u5f3a\u63d2\u4ef6 v6.7.10 \u2014 large-file-bridge \u89e6\u53d1\u6761\u4ef6\u653e\u5bbd + \u8de8\u6e20\u9053\u6fc0\u6d3b\uff1a\u7528\u6237\u5b9e\u6d4b v6.7.9 LLM \u5b8c\u5168\u6ca1\u8d70 enhance \u5f15\u5bfc\uff0c\u53cd\u800c\u8bfb source code \u81ea\u5df1\u8c03\u7814\u300eMAX_DOCUMENT_BYTES \u662f OpenClaw \u63d2\u4ef6 SDK inbound \u4e0b\u8f7d\u4e0a\u9650\u300f\u3002\u6839\u56e0\uff1av6.7.0 \u52a0\u7684 agentId.startsWith('wecom-') \u9650\u5236\u628a main agent / terminal / cli \u6e20\u9053\u5168\u90e8\u6392\u9664\u2014\u2014\u4f46\u300e\u89c6\u9891/\u6587\u4ef6\u8d85\u8fc7 100M\uff0c\u65e0\u6cd5\u4e0b\u8f7d\u300f\u662f\u4f01\u5fae\u72ec\u5bb6\u9519\u8bef\u6587\u672c\uff0c\u547d\u4e2d\u5373\u5fc5\u5b9a\u662f\u4f01\u5fae\u5927\u6587\u4ef6\u573a\u666f\uff0c\u4e0d\u8be5\u518d\u5361 agentId\u3002\u4fee\u6cd5\uff1a(1) before_prompt_build \u5220\u9664 WECOM_LARGE_FILE_ERROR \u547d\u4e2d\u540e\u7684 agentId \u68c0\u67e5\uff08\u4fdd\u7559 LARGE_FILE_INTENT \u4e3b\u52a8\u5f15\u5bfc\u4ecd\u5361 wecom-\uff09\uff1b(2) before_agent_reply \u540c\u6b65\u5220\u9664\u3002\u7ee7\u627f v6.7.9 baseUrl \u591a\u6e90\u89e3\u6790 + v6.7.8 /plugins/enhance/* URL \u7edf\u4e00\u3002",
  "type": "module",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "openclawVersion": "2026.4.29"
    },
    "compat": {
      "pluginApi": ">=2026.4.24"
    }
  },
  "bin": {
    "openclaw-enhance-setup": "./scripts/setup.sh"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postinstall": "node scripts/postinstall.cjs",
    "build": "tsc && cp package.json dist/ && cp openclaw.plugin.json dist/ 2>/dev/null || true"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "enhance",
    "memory",
    "safety",
    "agent"
  ],
  "author": "jobzhao15",
  "license": "MIT",
  "peerDependencies": {
    "openclaw": "^2026.4.24"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "src/**/*",
    "templates/**/*",
    "scripts/**/*",
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/huo15/ai/huo15-openclaw-enhance"
  }
}
