{
  "name": "@huo15/huo15-openclaw-enhance",
  "version": "6.7.12",
  "publishConfig": {
    "access": "public"
  },
  "description": "\u706b\u4e00\u4e94\u00b7\u514b\u52b3\u5fb7\u00b7\u9f99\u867e\u589e\u5f3a\u63d2\u4ef6 v6.7.12 \u2014 large-file-bridge \u81ea\u52a8\u751f\u6210 token URL\uff08\u515c\u5e95\u4e5f\u7ed9 token URL\uff0cAI \u8ffd\u8e2a\u96f6\u4f9d\u8d56\u5f31\u6a21\u578b\uff09\uff1a\u7528\u6237\u539f\u8bdd\u300e\u6ca1\u6709\u540e\u7f00 token \u554a\u300f\u3002v6.7.11 \u515c\u5e95\u867d\u7136\u7ed9\u4e86 https://.../plugins/enhance/upload \u5b8c\u6574 URL,\u4f46**\u6ca1 token**=AI \u4e0d\u80fd\u8ffd\u8e2a\u662f\u8c01\u4f20\u4e86\u4ec0\u4e48\u3002\u4fee\u6cd5\uff1abefore_prompt_build \u547d\u4e2d\u65f6**\u81ea\u52a8\u751f\u6210 12-hex token + \u5199 manifest**\uff08\u8ddf bot-upload-link \u5171\u7528 ~/.openclaw/upload/manifest.json\uff09,URL = /plugins/enhance-upload/<token>\u3002injectedSessions Map \u5347\u7ea7\u5b58 token,before_agent_reply \u515c\u5e95\u7528\u540c\u4e00 token \u62fc URL,\u524d\u540e\u4e00\u81f4\u3002prompt \u589e\u52a0\u300etoken \u5df2\u9884\u5907\u597d,\u76f4\u63a5\u53d1\u7ed9\u7528\u6237,\u4e0d\u8981\u518d\u8c03 enhance_upload_link\u300f\u6307\u4ee4\u907f\u514d\u91cd\u590d\u751f\u6210\u3002\u5373\u4f7f\u5f31\u6a21\u578b\u5b8c\u5168\u65e0\u89c6 prompt,\u515c\u5e95\u4e5f\u4fdd\u8bc1 LLM \u8f93\u51fa\u672b\u5c3e\u88ab appendText token URL,AI \u8c03 enhance_upload_check \u80fd\u67e5\u6e05\u5355\u3002",
  "type": "module",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "openclawVersion": "2026.4.29"
    },
    "compat": {
      "pluginApi": ">=2026.4.24"
    }
  },
  "bin": {
    "openclaw-enhance-setup": "./scripts/setup.sh"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postinstall": "node scripts/postinstall.cjs",
    "build": "tsc && cp package.json dist/ && cp openclaw.plugin.json dist/ 2>/dev/null || true"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "enhance",
    "memory",
    "safety",
    "agent"
  ],
  "author": "jobzhao15",
  "license": "MIT",
  "peerDependencies": {
    "openclaw": "^2026.4.24"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "src/**/*",
    "templates/**/*",
    "scripts/**/*",
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/huo15/ai/huo15-openclaw-enhance"
  }
}
