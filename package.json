{
  "name": "@huo15/huo15-openclaw-enhance",
  "version": "6.7.16",
  "publishConfig": {
    "access": "public"
  },
  "description": "\u706b\u4e00\u4e94\u00b7\u514b\u52b3\u5fb7\u00b7\u9f99\u867e\u589e\u5f3a\u63d2\u4ef6 v6.7.16 \u2014 bot-upload-link error path \u6f0f\u5224 hotfix\uff1av6.7.15 \u672c\u5730\u5b9e\u6d4b\u4e09\u8f6e\uff08\u76f4\u8fde/\u8fdc\u7a0b\u5168\u94fe\u8def/\u4e2d\u9014\u4e2d\u65ad\uff09\uff0c\u524d\u4e24\u8f6e\u5b8c\u7f8e\uff0c\u4f46\u7b2c\u4e09\u8f6e\u53d1\u73b0 req.on('error') / ws.on('error') \u89e6\u53d1\u540e Promise done\uff0c\u5916\u9762 `if (aborted)` \u4e0d\u62e6\u622a error case \u7ee7\u7eed\u8d70 renameSync(partial, file) \u2192 ENOENT \u8bef\u62a5 stderr\uff08partial \u5df2\u88ab rmSync \u5220\uff09\u3002\u529f\u80fd\u4e0a\u6ca1\u7834\u574f\u6570\u636e\uff08rename \u5931\u8d25 \u2192 \u65e7\u5b8c\u6574\u6587\u4ef6\u4f9d\u7136\u5b8c\u597d\uff09\uff0c\u4f46\u65e5\u5fd7\u6df7\u4e71\u3002\u4fee\u6cd5\uff1a\u52a0 `failed = true` flag\uff0cerror handler \u91cc set\uff0cPromise \u540e `if (aborted || failed) return` \u63d0\u524d\u51fa\u6808\uff0c\u4e0d\u8d70 rename \u8def\u5f84\u3002\u7ee7\u627f v6.7.15 .partial \u4e34\u65f6\u6587\u4ef6 + 4 \u6863\u5b8c\u6574\u65e5\u5fd7 + v6.7.14 config-doctor tools.profile \u68c0\u6d4b\u3002",
  "type": "module",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "build": {
      "openclawVersion": "2026.4.29"
    },
    "compat": {
      "pluginApi": ">=2026.4.24"
    }
  },
  "bin": {
    "openclaw-enhance-setup": "./scripts/setup.sh"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "release": "bash scripts/release.sh",
    "prepublishOnly": "npm run typecheck && npm run build",
    "postinstall": "node scripts/postinstall.cjs",
    "build": "tsc && cp package.json dist/ && cp openclaw.plugin.json dist/ 2>/dev/null || true"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "enhance",
    "memory",
    "safety",
    "agent"
  ],
  "author": "jobzhao15",
  "license": "MIT",
  "peerDependencies": {
    "openclaw": "^2026.4.24"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "typescript": "^5.5.0"
  },
  "files": [
    "index.ts",
    "openclaw.plugin.json",
    "src/**/*",
    "templates/**/*",
    "scripts/**/*",
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://cnb.cool/huo15/ai/huo15-openclaw-enhance"
  }
}
